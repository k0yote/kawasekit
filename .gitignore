# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
*.tsbuildinfo

# Astro (docs/) build + generated type artifacts
docs/.astro/
# starlight-typedoc writes generated API reference MDX into the source tree
# at build time. They are derived from src/ JSDoc and should not be tracked.
docs/src/content/docs/api/

# Test / coverage
coverage/

# Environment / secrets — never commit real .env
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Editors / IDEs
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Claude Code — local tooling state (plans, generated context stubs).
# The root CLAUDE.md is the project guide and IS tracked; the per-directory
# CLAUDE.md files are auto-generated tooling artifacts and are not.
.claude/
**/CLAUDE.md
!/CLAUDE.md

# JPYC reference contracts (license / repo-separation — read-only reference only)
fiat/

# Personal writing drafts — Zenn articles and X / SNS strategy notes live
# in this tree for convenience but are NOT part of the SDK and must not be
# committed.
zenn-*.md
Xスレッド戦略.md

# Example runtime state — session envelope files written by
# examples/*/scripts/session-demo.ts and the like.
.agent-state/

STATUS.md
STAUS_REVIEW.md

