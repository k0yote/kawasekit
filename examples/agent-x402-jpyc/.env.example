# agent-x402-jpyc — environment variables
#
# Copy this file to `.env` and fill in real values:
#   cp .env.example .env
#
# NEVER commit the real `.env` file (gitignored).
# NEVER share or log the private keys below.

# ============================================================================
# Required for the server (server/index.ts)
# ============================================================================

# Facilitator EOA — pays POL for gas to broadcast the
# `transferWithAuthorization` settlement transaction. Generate with:
#   node -e "console.log('0x' + require('crypto').randomBytes(32).toString('hex'))"
# Fund this address with Amoy POL: https://faucet.polygon.technology/
X402_FACILITATOR_PRIVATE_KEY=0x...

# Wallet address that receives the JPYC payment per request.
# Recommended: an EOA you control (NOT the agent's payer below).
X402_RECIPIENT=0x...

# Port the Hono server listens on. Default 8787.
# PORT=8787

# Decimal JPYC charged per /weather/:city call. Default "0.001".
# PRICE_JPYC=0.001

# Override the Polygon Amoy RPC URL (default: https://rpc-amoy.polygon.technology).
# Use a paid endpoint (Alchemy / Infura / QuickNode) if rate-limited.
# POLYGON_AMOY_RPC_URL=

# ============================================================================
# Required for the agent (agent/index.ts)
# ============================================================================

# Agent's payer EOA — holds JPYC, signs EIP-3009 authorizations to pay the
# paywall. MUST be different from X402_FACILITATOR_PRIVATE_KEY. Fund this
# address with Amoy JPYC: https://faucet.jpyc.co.jp/
AGENT_PAYER_PRIVATE_KEY=0x...

# Anthropic API key — the agent uses Claude to decide which cities to look
# up. Get a key at https://console.anthropic.com/.
ANTHROPIC_API_KEY=sk-ant-...

# URL of the local Hono server (default: http://127.0.0.1:8787).
# AGENT_SERVER_URL=http://127.0.0.1:8787

# User prompt the agent is given. Default exercises 3 city lookups.
# AGENT_PROMPT="What's the weather in Tokyo, Osaka, and Kyoto? Summarise each in one line."

# Anthropic model. Default "claude-sonnet-4-5".
# ANTHROPIC_MODEL=claude-sonnet-4-5

# Hard cap on JPYC the agent is willing to spend in this session.
# The agent aborts the tool call if it would push cumulative spend over this.
# Default "0.01" (= 10 calls at 0.001 JPYC each).
# AGENT_BUDGET_JPYC=0.01
