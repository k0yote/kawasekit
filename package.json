{
	"name": "kawasekit",
	"version": "0.1.0-beta.5",
	"description": "TypeScript SDK for stablecoin payments by AI agents. Japan-first, JPYC-native.",
	"license": "Apache-2.0",
	"author": "k0yote",
	"homepage": "https://kawasekit.k0yote.dev",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/k0yote/kawasekit.git"
	},
	"bugs": {
		"url": "https://github.com/k0yote/kawasekit/issues"
	},
	"keywords": [
		"stablecoin",
		"jpyc",
		"account-abstraction",
		"erc-4337",
		"ai-agents",
		"viem",
		"zerodev"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"bin": {
		"kawasekit": "./dist/cli/index.cjs"
	},
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./idempotency": {
			"import": {
				"types": "./dist/idempotency/index.d.ts",
				"default": "./dist/idempotency/index.js"
			},
			"require": {
				"types": "./dist/idempotency/index.d.cts",
				"default": "./dist/idempotency/index.cjs"
			}
		},
		"./idempotency/redis": {
			"import": {
				"types": "./dist/idempotency/redis/index.d.ts",
				"default": "./dist/idempotency/redis/index.js"
			},
			"require": {
				"types": "./dist/idempotency/redis/index.d.cts",
				"default": "./dist/idempotency/redis/index.cjs"
			}
		},
		"./x402": {
			"import": {
				"types": "./dist/x402/index.d.ts",
				"default": "./dist/x402/index.js"
			},
			"require": {
				"types": "./dist/x402/index.d.cts",
				"default": "./dist/x402/index.cjs"
			}
		},
		"./x402/hono": {
			"import": {
				"types": "./dist/x402/hono/index.d.ts",
				"default": "./dist/x402/hono/index.js"
			},
			"require": {
				"types": "./dist/x402/hono/index.d.cts",
				"default": "./dist/x402/hono/index.cjs"
			}
		},
		"./session": {
			"import": {
				"types": "./dist/session/index.d.ts",
				"default": "./dist/session/index.js"
			},
			"require": {
				"types": "./dist/session/index.d.cts",
				"default": "./dist/session/index.cjs"
			}
		},
		"./signer": {
			"import": {
				"types": "./dist/signer/index.d.ts",
				"default": "./dist/signer/index.js"
			},
			"require": {
				"types": "./dist/signer/index.d.cts",
				"default": "./dist/signer/index.cjs"
			}
		},
		"./policy": {
			"import": {
				"types": "./dist/policy/index.d.ts",
				"default": "./dist/policy/index.js"
			},
			"require": {
				"types": "./dist/policy/index.d.cts",
				"default": "./dist/policy/index.cjs"
			}
		},
		"./observability": {
			"import": {
				"types": "./dist/observability/index.d.ts",
				"default": "./dist/observability/index.js"
			},
			"require": {
				"types": "./dist/observability/index.d.cts",
				"default": "./dist/observability/index.cjs"
			}
		},
		"./observability/prometheus": {
			"import": {
				"types": "./dist/observability/prometheus/index.d.ts",
				"default": "./dist/observability/prometheus/index.js"
			},
			"require": {
				"types": "./dist/observability/prometheus/index.d.cts",
				"default": "./dist/observability/prometheus/index.cjs"
			}
		},
		"./observability/otlp": {
			"import": {
				"types": "./dist/observability/otlp/index.d.ts",
				"default": "./dist/observability/otlp/index.js"
			},
			"require": {
				"types": "./dist/observability/otlp/index.d.cts",
				"default": "./dist/observability/otlp/index.cjs"
			}
		}
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"engines": {
		"node": ">=22"
	},
	"packageManager": "pnpm@11.2.2",
	"scripts": {
		"build": "tsup",
		"typecheck": "tsc --noEmit",
		"test": "vitest run --passWithNoTests",
		"test:watch": "vitest",
		"lint": "biome check .",
		"format": "biome format --write .",
		"m1:create-account": "tsx scripts/01-create-account.ts",
		"m2:transfer-jpyc": "tsx scripts/03-transfer-jpyc.ts",
		"m2:transfer-with-policy": "tsx scripts/04-transfer-with-policy.ts",
		"m2:verify-eip3009-rejects-smart-account": "tsx scripts/05-verify-eip3009-smart-account.ts",
		"m2:policy-violation": "tsx scripts/06-policy-violation.ts",
		"m3:x402-self-settle": "tsx scripts/07-x402-self-settle.ts",
		"m3:session-issue-restore": "tsx scripts/09-session-issue-restore.ts",
		"m3:session-revoke": "tsx scripts/10-session-revoke.ts",
		"m4:mainnet-self-settle": "tsx scripts/11-mainnet-self-settle.ts",
		"m4:mainnet-session-flow": "tsx scripts/12-mainnet-session-flow.ts",
		"m4:inspect-wallets": "tsx scripts/13-inspect-wallets.ts",
		"m5:kairos-x402-self-settle": "tsx scripts/14-kairos-x402-self-settle.ts",
		"cli": "tsx cli/index.ts"
	},
	"dependencies": {
		"@zerodev/ecdsa-validator": "5.4.9",
		"@zerodev/permissions": "5.5.14",
		"@zerodev/sdk": "5.5.10",
		"commander": "13.1.0",
		"tslib": "2.8.1",
		"viem": "2.50.4"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.15",
		"@changesets/cli": "^2.31.0",
		"@opentelemetry/api": "1.9.0",
		"@opentelemetry/sdk-metrics": "1.30.1",
		"@types/node": "^22.0.0",
		"@x402/core": "2.13.0",
		"dotenv": "^17.4.2",
		"fast-check": "^4.8.0",
		"hono": "4.12.22",
		"prom-client": "15.1.3",
		"prool": "^0.2.4",
		"tsup": "^8.5.1",
		"tsx": "^4.22.3",
		"typescript": "6.0.3",
		"vitest": "^4.1.7"
	},
	"peerDependencies": {
		"@opentelemetry/api": ">=1.9.0",
		"hono": ">=4.10.0",
		"prom-client": ">=15.0.0"
	},
	"peerDependenciesMeta": {
		"@opentelemetry/api": {
			"optional": true
		},
		"hono": {
			"optional": true
		},
		"prom-client": {
			"optional": true
		}
	}
}
