# kawasekit — environment variables
#
# Copy this file to `.env` and fill in real values:
#   cp .env.example .env
#
# NEVER commit the real `.env` file. It is gitignored on purpose.
# NEVER share or log the private keys below.

# ============================================================================
# Required for ALL scripts
# ============================================================================

# Private key of the smart account OWNER (the EOA signer).
# 0x-prefixed 32-byte hex. Use a throwaway testnet key.
# Holds sudo authority on the Kernel smart account.
OWNER_PRIVATE_KEY=0x...

# ZeroDev project ID. Create a project at https://dashboard.zerodev.app
# and copy its ID here. Used to build the ZeroDev v3 RPC URL
# (bundler + paymaster) for Polygon Amoy.
ZERODEV_PROJECT_ID=

# ============================================================================
# Required for M2-3 (policy / session-key scripts)
#   - scripts/04-transfer-with-policy.ts   (pnpm m2:transfer-with-policy)
#   - scripts/06-policy-violation.ts       (pnpm m2:policy-violation)
# ============================================================================

# Session key for the policy-enforced agent flow.
# Generate with:
#   node -e "console.log('0x' + require('crypto').randomBytes(32).toString('hex'))"
# DO NOT reuse the owner key — the whole point of the session key is to be
# limited by the on-chain policy and recoverable if compromised.
SESSION_KEY_PRIVATE_KEY=0x...

# ============================================================================
# Optional overrides (sensible defaults applied if unset)
# ============================================================================

# Recipient of the test transfer. Defaults to the smart account itself
# (loop-back) so test JPYC stays under your control.
# JPYC_RECIPIENT=0x...

# Amount to send in scripts/03 and scripts/04, in decimal JPYC.
# Default: 1
# JPYC_AMOUNT_HUMAN=1

# Per-transfer cap installed into the Daily Limit policy (scripts/04 & 06).
# Default: 100 in scripts/04, 10 in scripts/06.
# JPYC_MAX_PER_TX_HUMAN=10

# Max number of transfers per 24h window in the Daily Limit policy.
# Default: 10
# JPYC_MAX_PER_DAY=10

# ============================================================================
# Required for M3-1 (x402 self-facilitator E2E)
#   - scripts/07-x402-self-settle.ts   (pnpm m3:x402-self-settle)
#
# Naming note: M3-1 has TWO distinct EOAs that play opposite roles. Keep them
# separate — confusing them is the most common setup mistake.
#
#   X402_PAYER       — signs EIP-3009 off-chain; **must hold JPYC**
#                      (does NOT need POL — it never broadcasts on-chain)
#   X402_FACILITATOR — broadcasts settlement; **must hold POL**
#                      (does NOT need JPYC — only moves other people's JPYC
#                      via `transferWithAuthorization` on their signature)
# ============================================================================

# Private key of the x402 PAYER EOA — signs EIP-3009 authorizations.
# Generate with:
#   node -e "console.log('0x' + require('crypto').randomBytes(32).toString('hex'))"
# Fund this address with Amoy JPYC from:
#   https://faucet.jpyc.co.jp/
# Must be different from OWNER_PRIVATE_KEY and from X402_FACILITATOR_PRIVATE_KEY.
# X402_PAYER_PRIVATE_KEY=0x...

# Private key of the FACILITATOR EOA — pays POL for gas to broadcast the
# `transferWithAuthorization` settlement transaction. Generate with:
#   node -e "console.log('0x' + require('crypto').randomBytes(32).toString('hex'))"
# Fund this address with Amoy POL from:
#   https://faucet.polygon.technology/
# X402_FACILITATOR_PRIVATE_KEY=0x...

# ============================================================================
# Optional overrides for M3-1
# ============================================================================

# Recipient of the JPYC payment in scripts/07. Default: the payer's own
# address (loop-back so testnet JPYC stays under your control).
# X402_RECIPIENT=0x...

# Decimal JPYC charged per call in scripts/07. Default "0.01".
# X402_AMOUNT_HUMAN=0.01

# Override the Polygon Amoy RPC URL (default: https://rpc-amoy.polygon.technology).
# Use a paid endpoint (Alchemy / Infura / QuickNode) if the public one rate-limits.
# POLYGON_AMOY_RPC_URL=
